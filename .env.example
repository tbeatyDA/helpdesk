# /opt/helpdesk/.env.example
#
# Copy to .env and fill in every REQUIRED value before running docker compose up.
#
# IMPORTANT: The O365 credentials here must come from a DEDICATED app registration
# created specifically for the helpdesk. Do NOT reuse the IT Inventory app
# registration. See SETUP.md for the full secure setup walkthrough.

# ── Core ─────────────────────────────────────────────────────────────────────
ENVIRONMENT=production

# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REQUIRED_change_this_to_a_long_random_string

# ── Database ─────────────────────────────────────────────────────────────────
# Connects to the same Postgres instance as IT Inventory (container name: db).
# Get POSTGRES_PASSWORD from /opt/it-inventory/.env
DATABASE_URL=postgresql+psycopg2://inventory:REQUIRED_db_password@db:5432/inventory

# ── Office 365 — HELPDESK-DEDICATED APP REGISTRATION ─────────────────────────
# These credentials are for a NEW app registration created solely for the
# helpdesk. It must have Application-level Mail.Read and Mail.Send permissions
# AND an Exchange ApplicationAccessPolicy restricting it to helpdesk@dayair.org
# only. See SETUP.md → Steps 1–5.
O365_TENANT_ID=REQUIRED_your_tenant_id
O365_CLIENT_ID=REQUIRED_helpdesk_app_client_id

# ── Authentication: choose ONE of the two options below ──────────────────────
#
# OPTION A — Client secret (only if your tenant policy permits it)
O365_CLIENT_SECRET=
#
# OPTION B — Certificate (required if your tenant blocks client secrets)
# Generate the cert on the server:
#   openssl req -x509 -newkey rsa:2048 -keyout /opt/helpdesk/helpdesk-graph.key \
#       -out /opt/helpdesk/helpdesk-graph.crt -days 730 -nodes \
#       -subj "/CN=Day Air Helpdesk Graph/O=Day Air Credit Union"
#   chmod 600 /opt/helpdesk/helpdesk-graph.key
# Then upload helpdesk-graph.crt to Azure → App registration → Certificates & secrets → Certificates.
# Copy the Thumbprint shown after upload.
O365_CLIENT_CERT_PATH=/opt/helpdesk/helpdesk-graph.key
O365_CLIENT_CERT_THUMBPRINT=
# ─────────────────────────────────────────────────────────────────────────────

O365_REDIRECT_URI=https://servicedesk.dayair.org/api/auth/callback

# Comma-separated UPNs granted the admin role in the helpdesk portal on first login.
O365_ADMIN_USERS=tbeaty@dayair.org

# Leave blank to allow all users in the tenant to log in,
# or list specific UPNs to restrict access.
O365_ALLOWED_USERS=

# ── Helpdesk mailbox ─────────────────────────────────────────────────────────
# The mailbox the app polls for new tickets and sends replies from.
# Must match the mailbox locked down by your ApplicationAccessPolicy.
HELPDESK_EMAIL=helpdesk@dayair.org

# How often (in seconds) to poll the inbox for new emails.
HELPDESK_POLL_INTERVAL=60
# Only process emails on or after this date (YYYY-MM-DD).
# Set to your go-live date so old mailbox history is permanently ignored.
HELPDESK_START_DATE=2026-06-18

# ── CORS / session ───────────────────────────────────────────────────────────
FRONTEND_URL=https://servicedesk.dayair.org
CORS_ALLOW_ORIGINS=https://servicedesk.dayair.org
